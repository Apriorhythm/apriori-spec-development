{
  "name": "apriori-cli",
  "version": "3.2.0",
  "description": "Spec-driven development with executable specs \u2014 self-contained, zero-dependency CLI",
  "type": "commonjs",
  "bin": {
    "apriori": "bin/apriori.js"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "verify": "node bin/apriori.js verify --specs apriori/specs --test-cmd \"node --test --test-reporter=tap \\\"test/*.test.js\\\"\""
  },
  "files": [
    "bin/",
    "lib/",
    "templates/",
    "RUNBOOK.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "spec-driven-development",
    "sdd",
    "executable-specs",
    "spec",
    "ai-coding",
    "agent-workflow",
    "claude-code",
    "codex",
    "cursor",
    "cli"
  ],
  "author": "Apriorhythm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Apriorhythm/apriori-spec-development.git"
  },
  "homepage": "https://github.com/Apriorhythm/apriori-spec-development/tree/v3#readme",
  "bugs": {
    "url": "https://github.com/Apriorhythm/apriori-spec-development/issues"
  },
  "license": "MIT"
}
