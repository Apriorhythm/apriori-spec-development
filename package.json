{
  "name": "apriori-cli",
  "version": "3.0.0-alpha.0",
  "description": "Spec-driven development with executable specs — self-contained, zero-dependency CLI",
  "type": "commonjs",
  "bin": {
    "apriori": "bin/apriori.js"
  },
  "scripts": {
    "test": "node --test",
    "verify": "node bin/apriori.js verify --specs apriori/specs --test-cmd \"node --test --test-reporter=tap\""
  },
  "files": [
    "bin/",
    "lib/",
    "templates/"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
